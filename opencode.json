{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "npm create *": "allow",
      "npm install *": "allow",
      "npm run build*": "allow",
      "npm run dev*": "allow",
      "* --version": "allow",
      "* --help *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "rm *": "deny",
      "git rm *": "deny",
      "sudo *": "deny"
    },
    "external_directory": {
      "*": "ask",
      "/tmp/**": "allow"
    }
  }
}
