{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "npm run build*": "allow",
      "npm run dev*": "allow",
      "npm install*": "allow",
      "rm -rf *": "deny",
      "sudo *": "deny"
    },
    "external_directory": {
      "*": "ask"
    }
  }
}
